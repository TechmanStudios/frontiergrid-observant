# Keep secrets out of git. This Phase I scaffold should run without external credentials.
FRONTIERGRID_ENV=development
FRONTIERGRID_DATA_ROOT=data
FRONTIERGRID_ARTIFACT_ROOT=artifacts/demo

# Optional local paths for later adapter work. Do not point these at classified or CUI data.
FRONTIER_OS_ROOT=../Frontier_OS-main/Frontier_OS-main/Exciton-MoA
FRONTIER_OS_NODE_COUNT=128
FRONTIER_OS_TAU_THRESHOLD=1.0
SOL_ROOT=../sol-main/sol-main
