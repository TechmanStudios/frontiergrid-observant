{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservantEvent",
  "type": "object",
  "required": ["event_id", "scenario_id", "tick", "timestamp", "domain", "modality", "source_id", "source_reliability", "classification"],
  "properties": {
    "event_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "tick": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "domain": { "type": "string" },
    "modality": { "type": "string" },
    "source_id": { "type": "string" },
    "source_reliability": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification": { "type": "string", "const": "unclassified_synthetic" },
    "entity_refs": { "type": "array", "items": { "type": "string" } },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "attributes": { "type": "object" },
    "text": { "type": ["string", "null"] },
    "ground_truth": { "type": ["object", "null"] }
  }
}
